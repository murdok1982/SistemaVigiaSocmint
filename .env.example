# ─────────────────────────────────────────────────────────────────────
# VIGIA - Plantilla de variables de entorno
# ─────────────────────────────────────────────────────────────────────
# Copiar a .env y rellenar. NUNCA commitear .env al repo.
#
# Generar todas las claves criptograficas con:
#     openssl rand -hex 32
#
# docker-compose abortara con error si una variable marcada REQUIRED
# no esta definida.
# ─────────────────────────────────────────────────────────────────────

# ─── Aplicacion (REQUIRED para algunas, OPTIONAL para otras) ─────────
VIGIA_ENV=production               # OPTIONAL  (development | staging | production)
VIGIA_LOG_LEVEL=INFO               # OPTIONAL  (DEBUG | INFO | WARNING | ERROR)
VIGIA_ALLOWED_ORIGINS=http://localhost:3000,https://vigia.gov.int  # OPTIONAL

# ─── PostgreSQL (REQUIRED) ───────────────────────────────────────────
POSTGRES_USER=vigia
POSTGRES_PASSWORD=                 # REQUIRED  openssl rand -hex 32
POSTGRES_DB=vigia_db

# ─── Redis (REQUIRED) ────────────────────────────────────────────────
REDIS_PASSWORD=                    # REQUIRED  openssl rand -hex 32

# ─── Seguridad - JWT (REQUIRED) ──────────────────────────────────────
JWT_SECRET_KEY=                    # REQUIRED  openssl rand -hex 32
ACCESS_TOKEN_EXPIRE_MINUTES=15     # OPTIONAL
REFRESH_TOKEN_EXPIRE_DAYS=7        # OPTIONAL

# ─── Seguridad - Cifrado (REQUIRED) ──────────────────────────────────
VIGIA_MASTER_KEY=                  # REQUIRED  openssl rand -hex 32
VIGIA_HMAC_KEY=                    # REQUIRED  openssl rand -hex 32
HMAC_SECRET=                       # REQUIRED  openssl rand -hex 32
VIGIA_HASH_SALT=                   # REQUIRED  openssl rand -hex 16

# ─── Seguridad - API key (REQUIRED para escrituras) ──────────────────
VIGIA_API_KEY=                     # REQUIRED  openssl rand -hex 32

# ─── APIs sociales (OPTIONAL) ────────────────────────────────────────
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
YOUTUBE_API_KEY=

# ─── SIEM (OPTIONAL) ─────────────────────────────────────────────────
SIEM_TYPE=splunk                   # splunk | elk | qradar | arcsight
SIEM_HOST=localhost
SIEM_PORT=9997
SIEM_API_ENDPOINT=https://localhost:8088/services/collector
SIEM_API_TOKEN=
SIEM_USE_TLS=false

# ─── STIX / TAXII (OPTIONAL) ─────────────────────────────────────────
TAXII_SERVER_URL=https://taxii.gov.int/api/v2
TAXII_API_KEY=
EUROPOL_API_ENDPOINT=https://api.europol.europa.eu/siena/v1/alerts
EUROPOL_API_KEY=

# ─── Honeypot / Dark Web (OPTIONAL) ──────────────────────────────────
DARKWEB_MONITORING_ENABLED=false
HONEYPOT_API_ENDPOINT=

# ─── Notificaciones (OPTIONAL) ───────────────────────────────────────
SMTP_HOST=smtp.gov.int
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_NOTIFICATION_EMAIL=security-team@gov.int

# ─── MFA (OPTIONAL) ──────────────────────────────────────────────────
MFA_ISSUER=VIGIA System
MFA_ENABLED=true

# ─── Performance (OPTIONAL) ──────────────────────────────────────────
WORKERS=4
MAX_CONNECTIONS=1000
REQUEST_TIMEOUT=30

# ─── Feature Flags (OPTIONAL) ────────────────────────────────────────
ENABLE_MAP_VIEW=true
ENABLE_NETWORK_GRAPHS=true
ENABLE_REPORT_GENERATOR=true
ENABLE_MOBILE_SYNC=true
ENABLE_STIX_EXPORT=true
ENABLE_SIEM_INTEGRATION=true

# ─── Grafana (REQUIRED si se usa monitoring) ──────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                # REQUIRED  openssl rand -hex 32 (NUNCA usar "admin")
GRAFANA_ROOT_URL=http://localhost:3001
